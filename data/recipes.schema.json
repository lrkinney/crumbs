{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "image",
      "description",
      "baseServings",
      "estimateMinor",
      "tags",
      "ingredients",
      "schemaVersion",
      "timing",
      "nutrition",
      "equipment",
      "cost",
      "source",
      "instructionDetails",
      "scalingNotes",
      "extensions"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "image": {
        "type": [
          "string",
          "null"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "baseServings": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "estimateMinor": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "ingredients": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "foodId",
            "label",
            "amount",
            "unit",
            "aisle",
            "id",
            "originalText",
            "preparation",
            "group",
            "optional"
          ],
          "properties": {
            "foodId": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "g",
                "ml",
                "each"
              ]
            },
            "aisle": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "originalText": {
              "type": [
                "string",
                "null"
              ]
            },
            "preparation": {
              "type": [
                "string",
                "null"
              ]
            },
            "group": {
              "type": [
                "string",
                "null"
              ]
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        "minItems": 1
      },
      "schemaVersion": {
        "const": 2
      },
      "timing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prepMinutes",
          "cookMinutes",
          "totalMinutes"
        ],
        "properties": {
          "prepMinutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cookMinutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "totalMinutes": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "nutrition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "basis",
          "calories",
          "proteinG",
          "carbohydrateG",
          "fatG",
          "source"
        ],
        "properties": {
          "basis": {
            "const": "per-serving"
          },
          "calories": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "proteinG": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "carbohydrateG": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fatG": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "source": {
            "type": "string"
          }
        }
      },
      "equipment": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "cost": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "basis",
          "estimated",
          "source",
          "region",
          "asOf"
        ],
        "properties": {
          "currency": {
            "const": "USD"
          },
          "basis": {
            "const": "base-recipe"
          },
          "estimated": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "asOf": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url",
          "notes"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "instructionDetails": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "text",
            "ingredientIds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "ingredientIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "minItems": 1
      },
      "scalingNotes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "extensions": {
        "type": "object"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
